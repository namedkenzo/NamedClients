<Window x:Class="NamedP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NamedP" Title="namedP" Width="540" Height="870" MinWidth="490" MinHeight="740" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <DockPanel LastChildFill="True" Background="{DynamicResource Bg}">
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="30,12,30,16"><StackPanel>
   <Button x:Name="ConnectButton" Click="ToggleConnection" Content="Connect →" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" FontWeight="SemiBold" FontSize="15" Padding="20,13" Margin="0"/>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,9,0,10"><Grid><StackPanel><TextBlock Text="RELAY DELAY" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Delay" Text="Not tested" FontSize="12" Margin="0,4,120,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel><Button x:Name="TestButton" Content="Test delay" Click="TestDelay" Padding="12,9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
   <Grid><Button Content="GitHub ↗" Click="OpenGithub" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="ClientVersion" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="10"/></Grid>
  </StackPanel></Border>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="30,26,30,22">
   <Grid Margin="0,0,0,22">
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" CornerRadius="15" Background="{DynamicResource Soft}" Margin="0,0,12,0">
      <Grid Width="24" Height="25">
       <Ellipse Fill="{DynamicResource Accent}" Width="14" Height="11" VerticalAlignment="Bottom"/>
       <Ellipse Fill="{DynamicResource Accent}" Width="6" Height="8" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top"/>
       <Ellipse Fill="{DynamicResource Accent}" Width="6" Height="8" Margin="0,-2,0,0" VerticalAlignment="Top"/>
       <Ellipse Fill="{DynamicResource Accent}" Width="6" Height="8" HorizontalAlignment="Right" Margin="0,1,0,0" VerticalAlignment="Top"/>
      </Grid>
     </Border>
     <StackPanel VerticalAlignment="Center"><TextBlock FontSize="26" FontWeight="SemiBold" Text="namedP"/><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,2,0,0" Text="Your little connection companion."/></StackPanel>
    </StackPanel>
    <ComboBox x:Name="Theme" Width="92" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ThemeChanged" SelectedIndex="0" AutomationProperties.Name="Color theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
   </Grid>
   <Border CornerRadius="26" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18,16,18,19">
    <StackPanel>
     <Grid><TextBlock Text="A LITTLE COMPANION. A PRIVATE CONNECTION." FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Fill="#D59A61" Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="ICMP" FontSize="9" Foreground="{DynamicResource Muted}"/></StackPanel></Grid>
     <Grid Height="144"><Ellipse Width="136" Height="136" Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.13"/><Ellipse Width="104" Height="104" Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.10"/><local:Dachshund x:Name="Dog"/></Grid>
     <Border HorizontalAlignment="Center" CornerRadius="15" Background="{DynamicResource Surface}" Padding="12,6"><TextBlock x:Name="StateLabel" Text="●  Ready when you are" Foreground="{DynamicResource Muted}" FontSize="11" AutomationProperties.LiveSetting="Polite"/></Border>
     <TextBlock x:Name="Headline" Text="Your network, a little calmer." FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBlock x:Name="Hint" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="8,8,8,0"/>
    </StackPanel>
   </Border>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="21" Padding="18" Margin="0,14,0,0">
    <StackPanel>
     <Grid Margin="0,0,0,12"><TextBlock Text="Connection link" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ForgetButton" Content="Forget" Click="ForgetProfile" Background="Transparent" BorderThickness="0" Padding="10,6" Foreground="{DynamicResource Muted}" ToolTip="Remove the saved link from this Windows account"/><Button x:Name="PasteButton" Content="Paste" Click="PasteLink" Padding="12,6" Margin="4,0,0,0"/></StackPanel></Grid>
     <Border CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg}" Padding="12,13"><PasswordBox x:Name="Link" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}" FontSize="14" AutomationProperties.Name="PingTunnel connection link"/></Border>
     <TextBlock x:Name="ProfileNote" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="1,9,0,0" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="Error" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive"/>
     <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="10,8" Margin="0,8,0,0"><TextBlock x:Name="ProfileMode" Text="Mode follows the configuration" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
     <CheckBox x:Name="Gaming" Margin="0,13,0,0" Content="Gaming" Foreground="{DynamicResource Text}" ToolTip="Reconnect to apply. Short UDP queues discard packets queued over 150 ms under load; loss may increase. No guaranteed lower game ping." Checked="GamingChanged" Unchecked="GamingChanged"/>
     <TextBlock Text="Shorter UDP queues · reconnect to apply" Foreground="{DynamicResource Muted}" FontSize="10" Margin="40,3,0,0"/>
    </StackPanel>
   </Border>
   <Grid Margin="6,16,6,0"><StackPanel><TextBlock Text="TRANSFERRED" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Traffic" Text="↑ 0 B     ↓ 0 B" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="SESSION" FontSize="9" Foreground="{DynamicResource Muted}" TextAlignment="Right"/><TextBlock x:Name="Elapsed" Text="00:00" FontSize="12" Margin="0,5,0,0" TextAlignment="Right"/></StackPanel></Grid>
  </StackPanel>
 </ScrollViewer>
 </DockPanel>
</Window>

