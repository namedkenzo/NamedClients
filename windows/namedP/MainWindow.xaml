<Window x:Class="NamedP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NamedP" Title="namedP" Width="530" Height="800" MinWidth="480" MinHeight="740" Background="{DynamicResource Bg}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="32,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="280"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="namedP"/><TextBlock Margin="1,4,0,0" Foreground="{DynamicResource Muted}" FontSize="12" Text="A little companion. A private connection."/></StackPanel><ComboBox x:Name="Theme" Foreground="#173A31" Width="93" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="ThemeChanged" SelectedIndex="0" AutomationProperties.Name="Color theme"><ComboBoxItem><TextBlock Foreground="#173A31" Text="System"/></ComboBoxItem><ComboBoxItem><TextBlock Foreground="#173A31" Text="Dark"/></ComboBoxItem><ComboBoxItem><TextBlock Foreground="#173A31" Text="Light"/></ComboBoxItem></ComboBox></Grid>
  <Border Grid.Row="1" Margin="0,22,0,0" Padding="12" CornerRadius="17" Background="{DynamicResource Surface}"><StackPanel><TextBlock x:Name="ProfileMode" Text="Mode follows the configuration" FontWeight="SemiBold"/><CheckBox x:Name="Gaming" Margin="0,10,0,0" Content="Gaming · shorter UDP queues (reconnect to apply)" Foreground="{DynamicResource Text}" ToolTip="Opt-in: discard stale queued UDP after 150 ms; may increase loss under load. No guaranteed game ping." Checked="GamingChanged" Unchecked="GamingChanged"/></StackPanel></Border>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Ellipse Width="240" Height="240" Stroke="{DynamicResource Line}" StrokeThickness="1" Opacity="0.45"/><Ellipse Width="180" Height="180" Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.16"/><local:Dachshund x:Name="Dog"/><Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" CornerRadius="20" Background="{DynamicResource Surface}" Padding="14,7"><TextBlock x:Name="StateLabel" Text="●  Ready when you are" Foreground="{DynamicResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border></Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="Headline" Text="Your network, a little calmer." FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="Hint" Text="Paste a profile; its mode selects VPN or local SOCKS5." Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,22"/></StackPanel>
  <StackPanel Grid.Row="4"><Grid Margin="0,0,0,9"><TextBlock Text="CONNECTION LINK" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="Paste" Click="PasteLink" Padding="10,3"/></Grid><Border CornerRadius="13" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}" Padding="14,14"><PasswordBox x:Name="Link" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" FontSize="14" AutomationProperties.Name="PingTunnel connection link"/></Border><TextBlock x:Name="Error" Foreground="#E79483" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,5" AutomationProperties.LiveSetting="Assertive"/></StackPanel>
  <StackPanel Grid.Row="5" Margin="0,8,0,0"><Button x:Name="ConnectButton" Click="ToggleConnection" Content="Connect →" Background="{DynamicResource Accent}" Foreground="#10251F" FontWeight="SemiBold" FontSize="16" Padding="20,17"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Delay" Text="Relay delay: not tested" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" x:Name="TestButton" Content="Test delay" Click="TestDelay" Padding="12,8"/></Grid><Grid Margin="5,16,5,10"><TextBlock x:Name="Traffic" Text="↑ 0 B     ↓ 0 B" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="Elapsed" HorizontalAlignment="Right" Text="00:00" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid></StackPanel>
  <Grid Grid.Row="6" Margin="0,15,0,0"><Button Content="GitHub ↗" Click="OpenGithub" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent"/><TextBlock x:Name="ClientVersion" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid>
 </Grid></ScrollViewer>
</Window>

